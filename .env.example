# ==========================================================
#  MOLIYA BOT — SOZLAMALAR
#  Bu faylni ".env" nomi bilan saqlang va qiymatlarni to'ldiring.
#  "=" belgisidan keyin bo'sh joy va qo'shtirnoq qo'ymang.
# ==========================================================

# 1) MAJBURIY: BotFather bergan token
#    Misol: 1234567890:AAExampleTokenFromBotFather
BOT_TOKEN=

# 2) MAJBURIY: Neon (neon.tech) bazasining connection string manzili
#    Misol: postgresql://user:parol@ep-xxxx.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# 3) MAJBURIY: Admin Panelga kirish paroli (o'zingiz o'ylab toping, kamida 8 belgi)
ADMIN_PASSWORD=

# ---------------------- IXTIYORIY ----------------------

# Server porti (o'zgartirish shart emas)
PORT=3000

# Biznesingiz nomi (hisobotlarda ko'rinadi)
BUSINESS_NAME=Mening biznesim

# Mini App'ning internet (https) manzili. BO'SH QOLDIRING: dastur uni o'zi topadi
# (ngrok ishlayotgan bo'lsa undan, bo'lmasa tools/cloudflared.exe orqali o'zi ochadi).
# Misol: https://abcd-1234.ngrok-free.app
WEBAPP_URL=

# Avtomatik tunnel: auto (tavsiya) yoki off (tunnel ochilmasin)
TUNNEL=auto

# ---------- INTERNETGA JOYLASH (Vercel + Render). Batafsil: DEPLOY.md ----------
# Bular faqat Render'dagi server uchun kerak; kompyuterda ishlatsangiz, tegmang.
# BOT_MODE=webhook
# PUBLIC_URL=https://xxxx.onrender.com     (Render'da RENDER_EXTERNAL_URL o'zi beriladi)
# CORS_ORIGINS=https://sizning-loyiha.vercel.app
# ADMIN_REMOTE=true                         (ADMIN_PASSWORD kamida 12 belgi bo'lishi shart)
# API_RATE_LIMIT=1500

# Ovozli xabarlarni matnga aylantirish. Ikki usul bor:
# STT=off              -> ovozli xabarlar butunlay o'chiriladi
# STT_MAX_SECONDS=60   -> bitta ovozli xabarning eng uzun davomiyligi (soniya)
#
# 1) Bepul, oflayn (standart). Yoqish: "npm run voice:setup" (bir marta, ~66 MB yuklaydi).
#    Haqiqiy (tabiiy) nutqda aniqligi past bo'lishi mumkin.
#
# 2) Aniqroq, lekin pullik: Yandex SpeechKit (ovoz internetga, Yandex'ga yuboriladi).
#    Qanday olish: DEPLOY.md dagi "Ovozli xabar: Yandex SpeechKit" bo'limiga qarang.
# STT_PROVIDER=yandex
# YANDEX_STT_API_KEY=
# YANDEX_STT_FOLDER_ID=

# Egasining Telegram ID raqami. BO'SH QOLDIRSANGIZ, birinchi marta
# ishga tushganda terminalda chiqadigan kod orqali egasi bo'lasiz.
OWNER_TELEGRAM_ID=

# Avtomatik xabarlar vaqti (Toshkent vaqti bilan, 0-23)
DAILY_REPORT_HOUR=21
DEBT_REMINDER_HOUR=9
