{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo Frontend paketlari build bosqichida ornatiladi",
  "buildCommand": "node scripts/vercel-build.js",
  "outputDirectory": "vercel-dist",
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "X-Robots-Tag": "noindex, nofollow"
      },
      "continue": true
    },
    { "src": "/admin(.*)", "headers": { "X-Frame-Options": "DENY" }, "continue": true },
    {
      "src": "/assets/(.*)",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "src": "/admin/assets/(.*)",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    { "handle": "filesystem" },
    { "src": "/admin(?:/(?!assets/).*)?", "dest": "/admin/index.html" },
    { "src": "/(.*)", "status": 404, "dest": "/404.html" }
  ]
}
